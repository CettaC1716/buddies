# Supabase Client Configuration (Dedicated Buddies Blitz project - set in .env or Vercel Environment Variables)
VITE_SUPABASE_URL=https://your-new-buddiesblitz-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_new_buddiesblitz_anon_key

# Developer Quality Control (QC) Menu Flag (Set to 'true' locally if needed; keep 'false' on Vercel)
VITE_ENABLE_QC=false

# NEAR Protocol Network Configuration (Testnet / Mainnet)
VITE_NEAR_NETWORK=testnet
VITE_NEAR_RPC_URL=https://rpc.testnet.near.org
VITE_NEAR_GAMEPASS_CONTRACT_ID=gamepass.buddiesblitz.testnet
VITE_NEAR_NEP245_CONTRACT_ID=items-nep245.buddiesblitz.testnet
